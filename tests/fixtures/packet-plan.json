      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "A",
            "divider": true,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": null}
