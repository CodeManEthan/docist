            ]
          },
          {
            "id": "s2",
            "title": "References",
            "divider": false,
            "items": [
              {"id": "i2", "kind": "file", "hash": "h-b", "label": "refs.pdf", "pages": null},
              {"id": "i3", "kind": "file", "hash": "h-c", "label": "letter.pdf", "pages": null}
            ]
