{
  "about": "Shared page-plan vectors for the packet builder (design.md section 3.3). pdf_ops/packet.py page_plan and static/packet-model.js must both turn each vector's packet, page_counts and contents_pages into exactly its expect.",
  "version": 1,
  "stage_order": ["B6", "B1", "B2", "B3", "B5", "B4"],
  "consumers": {
    "pipeline": "pdf_ops/packet.py page_plan, run by tests/backend/test_packet_pipeline.py",
    "model": "static/packet-model.js, run by tests/frontend/packet-model.test.js"
  },
  "rules": [
    "stage maps each consumer to the stage that builds the vector's feature in that consumer.",
    "A consumer's tests at stage S run a vector when stage_order puts its tag for that consumer at or before S, and skip it otherwise.",
    "Merge option_defaults under each packet's options before planning.",
    "page_counts holds one entry per hash with a ready row; a hash missing from it is not ready.",
    "contents_pages is the contents page count when options.contents is on; it defaults to 1.",
    "pages lists every physical page in order. index in entries is the 0-based physical page.",
    "label is the printed number or null for front matter; print says whether it is stamped.",
    "entries list each planned section and each file item that gives a page, in plan order; blank items get none."
  ],
  "option_defaults": {
    "paper": "letter",
    "page_numbers": true,
    "number_position": "bottom-right",
    "start_number": 1,
    "number_generated": false,
    "bookmarks": true,
    "contents": false,
    "recto_starts": false
  },
  "vectors": [
    {
      "name": "one-file-all-pages",
      "note": "pages: null expands to every page of the bound stage; the implicit section has an empty title.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": null}
            ]
          }
        ]
      },
      "page_counts": {"h-a": 3},
      "expect": {
        "pages": [
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 0, "rot": 0, "label": 1, "print": true},
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 1, "rot": 0, "label": 2, "print": true},
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 2, "rot": 0, "label": 3, "print": true}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "", "label": 1, "index": 0},
          {"kind": "item", "id": "i1", "section": "s1", "title": "a.pdf", "label": 1, "index": 0}
        ]
      }
    },
    {
      "name": "page-edits-across-files",
      "note": "Explicit refs keep their order and rotation; a deleted page is absent; a duplicated page appears twice; one file split into two items.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": [{"src": 2, "rot": 0}, {"src": 0, "rot": 90}], "key": "h-a::", "src_pages": 3},
              {"id": "i2", "kind": "file", "hash": "h-b", "label": "b.pdf", "pages": null},
              {"id": "i3", "kind": "file", "hash": "h-a", "label": "a.pdf (2)", "pages": [{"src": 1, "rot": 180}, {"src": 1, "rot": 270}], "key": "h-a::", "src_pages": 3}
            ]
          }
        ]
      },
      "page_counts": {"h-a": 3, "h-b": 2},
      "expect": {
        "pages": [
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 2, "rot": 0, "label": 1, "print": true},
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 0, "rot": 90, "label": 2, "print": true},
          {"kind": "file", "section": "s1", "item": "i2", "hash": "h-b", "src": 0, "rot": 0, "label": 3, "print": true},
          {"kind": "file", "section": "s1", "item": "i2", "hash": "h-b", "src": 1, "rot": 0, "label": 4, "print": true},
          {"kind": "file", "section": "s1", "item": "i3", "hash": "h-a", "src": 1, "rot": 180, "label": 5, "print": true},
          {"kind": "file", "section": "s1", "item": "i3", "hash": "h-a", "src": 1, "rot": 270, "label": 6, "print": true}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "", "label": 1, "index": 0},
          {"kind": "item", "id": "i1", "section": "s1", "title": "a.pdf", "label": 1, "index": 0},
          {"kind": "item", "id": "i2", "section": "s1", "title": "b.pdf", "label": 3, "index": 2},
          {"kind": "item", "id": "i3", "section": "s1", "title": "a.pdf (2)", "label": 5, "index": 4}
        ]
      }
    },
    {
      "name": "not-ready-and-emptied-items",
      "note": "A file whose hash has no ready row gives no pages; an item with every page deleted gives none; neither gets an entry.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-x", "label": "x.docx", "pages": null},
              {"id": "i2", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": [], "key": "h-a::", "src_pages": 3},
              {"id": "i3", "kind": "file", "hash": "h-b", "label": "b.pdf", "pages": null}
            ]
          }
        ]
      },
      "page_counts": {"h-a": 3, "h-b": 1},
      "expect": {
        "pages": [
          {"kind": "file", "section": "s1", "item": "i3", "hash": "h-b", "src": 0, "rot": 0, "label": 1, "print": true}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "", "label": 1, "index": 0},
          {"kind": "item", "id": "i3", "section": "s1", "title": "b.pdf", "label": 1, "index": 0}
        ]
      }
    },
    {
      "name": "blank-items-are-body-pages",
      "note": "A blank item is one body page: it is numbered and prints. It has no contents or outline entry.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {"start_number": 5},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "blank"},
              {"id": "i2", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": null},
              {"id": "i3", "kind": "blank"}
            ]
          }
        ]
      },
      "page_counts": {"h-a": 2},
      "expect": {
        "pages": [
          {"kind": "blank", "section": "s1", "item": "i1", "label": 5, "print": true},
          {"kind": "file", "section": "s1", "item": "i2", "hash": "h-a", "src": 0, "rot": 0, "label": 6, "print": true},
          {"kind": "file", "section": "s1", "item": "i2", "hash": "h-a", "src": 1, "rot": 0, "label": 7, "print": true},
          {"kind": "blank", "section": "s1", "item": "i3", "label": 8, "print": true}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "", "label": 5, "index": 0},
          {"kind": "item", "id": "i2", "section": "s1", "title": "a.pdf", "label": 6, "index": 1}
        ]
      }
    },
    {
      "name": "numbers-off-still-labels",
      "note": "With page_numbers off nothing prints, but labels are still planned for the contents and outline.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {"page_numbers": false, "start_number": 3},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-a", "label": "a.pdf", "pages": null},
              {"id": "i2", "kind": "blank"}
            ]
          }
        ]
      },
      "page_counts": {"h-a": 2},
      "expect": {
        "pages": [
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 0, "rot": 0, "label": 3, "print": false},
          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 1, "rot": 0, "label": 4, "print": false},
          {"kind": "blank", "section": "s1", "item": "i2", "label": 5, "print": false}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "", "label": 3, "index": 0},
          {"kind": "item", "id": "i1", "section": "s1", "title": "a.pdf", "label": 3, "index": 0}
        ]
      }
    },
    {
      "name": "nothing-to-plan",
      "note": "No item gives a page, so no section is in the plan.",
      "stage": {"pipeline": "B6", "model": "B6"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "",
            "divider": false,
            "items": [
              {"id": "i1", "kind": "file", "hash": "h-x", "label": "x.docx", "pages": null}
            ]
          }
        ]
      },
      "page_counts": {},
      "expect": {
        "pages": [],
        "entries": []
      }
    },
    {
      "name": "sections-in-order",
      "note": "Labels run on across sections; each section's entry points at its first page.",
      "stage": {"pipeline": "B6", "model": "B3"},
      "packet": {
        "version": 1,
        "title": "Vector",
        "options": {},
        "cover": null,
        "sections": [
          {
            "id": "s1",
            "title": "Resume",
            "divider": false,
