          {"kind": "file", "section": "s1", "item": "i1", "hash": "h-a", "src": 1, "rot": 0, "label": 2, "print": true},
          {"kind": "file", "section": "s2", "item": "i2", "hash": "h-b", "src": 0, "rot": 0, "label": 3, "print": true},
          {"kind": "file", "section": "s2", "item": "i3", "hash": "h-c", "src": 0, "rot": 0, "label": 4, "print": true},
          {"kind": "file", "section": "s2", "item": "i3", "hash": "h-c", "src": 1, "rot": 0, "label": 5, "print": true}
        ],
        "entries": [
          {"kind": "section", "id": "s1", "title": "Resume", "label": 1, "index": 0},
          {"kind": "item", "id": "i1", "section": "s1", "title": "resume.docx", "label": 1, "index": 0},
          {"kind": "section", "id": "s2", "title": "References", "label": 3, "index": 2},
          {"kind": "item", "id": "i2", "section": "s2", "title": "refs.pdf", "label": 3, "index": 2},
          {"kind": "item", "id": "i3", "section": "s2", "title": "letter.pdf", "label": 4, "index": 3}
        ]
      }
    },
    {
